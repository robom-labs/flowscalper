{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robom.local/schemas/system_status.schema.json",
  "title": "SystemStatus",
  "type": "object",
  "required": ["mode", "market_data_state", "execution_state", "venue", "run_id", "real_orders_enabled", "auth_required"],
  "properties": {
    "mode": {"enum": ["READY", "LIVE_SHADOW_PAPER", "DEMO_FIXTURE", "REPLAY"]},
    "market_data_state": {"enum": ["LIVE", "RECONNECTING", "STALE", "DISCONNECTED", "FIXTURE"]},
    "execution_state": {"const": "PAPER"},
    "venue": {"enum": ["NONE", "BINANCE_USDM", "BYBIT_LINEAR", "FIXTURE"]},
    "run_id": {"type": "string"},
    "real_orders_enabled": {"const": false},
    "auth_required": {"const": false},
    "starting_equity_usdt": {"type": "number", "minimum": 0},
    "current_equity_usdt": {"type": "number"},
    "realized_pnl_usdt": {"type": "number"},
    "unrealized_pnl_usdt": {"type": "number"},
    "cumulative_fees_usdt": {"type": "number", "minimum": 0},
    "cumulative_slippage_usdt": {"type": "number", "minimum": 0},
    "trade_count": {"type": "integer", "minimum": 0},
    "wide_symbols": {"type": "integer", "minimum": 0},
    "deep_symbols": {"type": "integer", "minimum": 0},
    "processing_lag_p95_ms": {"type": ["number", "null"], "minimum": 0},
    "health_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
