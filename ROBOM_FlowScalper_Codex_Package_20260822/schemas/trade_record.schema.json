{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robom.local/schemas/trade_record.schema.json",
  "title": "PaperTradeRecord",
  "type": "object",
  "required": ["trade_id", "run_id", "venue", "symbol", "strategy_id", "side", "entry_ts_ms", "exit_ts_ms", "entry_price", "exit_price", "quantity", "exit_reason", "gross_pnl_usdt", "fees_usdt", "slippage_usdt", "net_pnl_usdt"],
  "properties": {
    "trade_id": {"type": "string"},
    "run_id": {"type": "string"},
    "venue": {"type": "string"},
    "symbol": {"type": "string"},
    "strategy_id": {"type": "string"},
    "regime": {"type": "string"},
    "profile": {"enum": ["BASE", "STRESS"]},
    "side": {"enum": ["LONG", "SHORT"]},
    "entry_ts_ms": {"type": "integer"},
    "exit_ts_ms": {"type": "integer"},
    "entry_price": {"type": "string"},
    "exit_price": {"type": "string"},
    "initial_stop": {"type": "string"},
    "take_profit": {"type": "string"},
    "candidate_id": {"type": ["string", "null"]},
    "take_profit_1": {"type": ["string", "null"]},
    "take_profit_2": {"type": ["string", "null"]},
    "quantity": {"type": "string"},
    "exit_reason": {"enum": ["TAKE_PROFIT", "STOP", "EDGE_DECAY", "PROFIT_PROTECTION", "MAX_HOLD", "EMERGENCY_STALE", "DATA_GAP", "MANUAL_PAPER_EXIT", "FAULT"]},
    "gross_pnl_usdt": {"type": "string"},
    "fees_usdt": {"type": "string"},
    "slippage_usdt": {"type": "string"},
    "net_pnl_usdt": {"type": "string"},
    "mae_r": {"type": ["number", "null"]},
    "mfe_r": {"type": ["number", "null"]},
    "holding_ms": {"type": "integer", "minimum": 0},
    "flags": {"type": "array", "items": {"type": "string"}},
    "config_hash": {"type": "string"},
    "strategy_version": {"type": "string"}
  },
  "additionalProperties": false
}
