<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS 로그인 후 FlowScalper localhost 서버를 자동 복구하는 LaunchAgent 정의다. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>kr.robom.flowscalper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/run_macos_service.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/service.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/service-error.log</string>
</dict>
</plist>
