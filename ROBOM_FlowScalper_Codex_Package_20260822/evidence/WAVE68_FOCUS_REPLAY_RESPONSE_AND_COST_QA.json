  "defects": [
    {
      "id": "LIVE_FOCUS_OPTIONAL_CACHE_WRITE_WAIT",
      "root_cause": "The LIVE process-isolated focus request attempted an optional write to replay_focus_cache while the persistence connection could hold BEGIN IMMEDIATE with a 60-second busy timeout.",
      "fix": "The LIVE process path reads an existing cache but builds an uncached response with persist_cache=false and returns it without an SQLite write.",
      "strategy_thresholds_lowered": false
    },
    {
      "id": "FOCUS_TOTAL_FEE_SHOWN_AS_ENTRY_FEE",
      "root_cause": "ReplayPage assigned the completed trade total fee to entry_fee_usdt and always reported zero realized exit fee.",
      "fix": "Focus session v7 allocates the immutable total fee by executed entry and exit notional and preserves the exact ledger total. The UI shows entry plus estimated exit fee while open and entry plus realized exit fee when closed.",
      "strategy_thresholds_lowered": false
    },
    {
      "id": "FOCUS_COMPARISON_UNINDEXED_AND_LOW_PRIORITY_WORKER",
      "root_cause": "The bounded focus request still waited on the shared nice(19) replay worker and its comparison query lacked a matching Run, strategy, symbol, and side access path.",
      "fix": "The UI-only bounded focus read uses the existing query-only reader in asyncio.to_thread with dedicated comparison indexes. Full Run and precision timeline replay remain process isolated and nice(19).",
      "strategy_thresholds_lowered": false
    },
    {
      "id": "DASHBOARD_HISTORY_ORDER_PLAN_TEMP_BTREE",
      "root_cause": "SQLite selected the focus comparison index for full history ordering and built a temporary B-tree, extending restart cache warmup to 61,917.006ms.",
      "fix": "Purpose-built all-history and Run-history order indexes were added for trades and shadow_trades, with query-plan regression coverage that rejects a temporary B-tree.",
      "strategy_thresholds_lowered": false
    },
    {
      "id": "LAUNCHD_BOOTSTRAP_BEFORE_OLD_PID_EXIT",
      "root_cause": "launchctl bootout returned before the old Python process completed its graceful shutdown, so immediate bootstrap intermittently failed with macOS error 5.",
      "fix": "The installer waits up to 60 seconds for the captured old PID to disappear, then retries bootstrap at most three times with one-second intervals.",
      "strategy_thresholds_lowered": false
    },
    {
      "id": "STAGE_BUILD_STDOUT_CORRUPTED_JSON",
      "root_cause": "Frontend build stdout was written before the stage result and made latest-release-stage.json invalid JSON.",
      "fix": "Stage build output is directed away from the result stream and the installer parses status=ACTIVATED before switching the service.",
      "strategy_thresholds_lowered": false
    }
  ],
